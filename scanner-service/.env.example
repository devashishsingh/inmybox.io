# Local dev — copy to .env and fill in
PORT=8080
HOST=0.0.0.0

# Leave empty in dev to skip auth; set in prod (Render will generate one).
SCANNER_TOKEN=

# Cache
CACHE_TTL_MS=300000
CACHE_MAX=1000

# Rate limiting (per IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# CORS — comma-separated origins, or '*' for any
CORS_ORIGIN=*

LOG_LEVEL=info
